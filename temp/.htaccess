# FaviconForge Pro - Pasta Temp
# Permitir acesso aos arquivos gerados

# Permitir acesso geral
<IfModule mod_authz_core.c>
    Require all granted
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Allow from all
</IfModule>

# Bloquear execução de PHP por segurança
<FilesMatch "\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Desabilitar listagem de diretórios
Options -Indexes

# Permitir seguir links simbólicos
Options +FollowSymLinks

# Tipos MIME corretos
AddType image/png .png
AddType image/x-icon .ico
AddType image/jpeg .jpg .jpeg
AddType application/zip .zip
AddType application/json .json

# Headers de cache
<IfModule mod_headers.c>
    <FilesMatch "\.(png|jpg|jpeg|ico|gif|webp)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
</IfModule>
